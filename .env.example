# ============================================================
# NOVA LIFE SPACE PROPERTY EXPLORER - ENVIRONMENT CONFIGURATION
# ============================================================

PORT=3001
NODE_ENV=development
JWT_SECRET=nova-property-explorer-super-secure-jwt-key-2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTH (PRIMARY CLOUD DATABASE)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# RUNTIME CUSTOMER-FACING AI (GROQ / LLAMA 3.3 70B & GROK)
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback xAI Grok Endpoint (if using xAI directly)
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-70b

# ------------------------------------------------------------
# OFFICIAL NOVA WEBSITE
# ------------------------------------------------------------
NOVA_OFFICIAL_WEBSITE_URL=https://novalifespace.in
