# ============================================================
# NOVA LIFE SPACE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Set these environment variables in your Render / Vercel Dashboard)
# ============================================================

NODE_ENV=production
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTH (PRIMARY CLOUD DATABASE)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------
# RUNTIME CUSTOMER-FACING AI (GROQ / LLAMA 3.3 70B ENGINE)
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# OFFICIAL NOVA WEBSITE INTEGRATION
# ------------------------------------------------------------
NOVA_OFFICIAL_WEBSITE_URL=https://novalifespace.in
